{
  "name": "playlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently  -n \"REACT,DB\" -c \"\" \" npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "vite",
    "dev:back": "json-server db.json",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "auto-skeleton-react": "^1.0.5",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "json-server": "^1.0.0-beta.15",
    "lucide": "^1.73.0",
    "lucide-react": "^1.73.0",
    "morphicons": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
